{
  "expo": {
    "name": "PolicyPulse",
    "slug": "policypulse-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "policypulse",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.policypulse.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp", "tel", "mailto", "sms"]
      }
    },
    "android": {
      "package": "com.policypulse.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": ["INTERNET"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "policypulse" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://insurance-agent-saas-production.up.railway.app/api/v1",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": ""
    }
  }
}
