{
  "expo": {
    "name": "PolicyOffice",
    "slug": "policyoffice-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "policyoffice",
      "com.policyoffice.mobile"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.policyoffice.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tel",
          "mailto",
          "sms"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.policyoffice.mobile",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "policyoffice"
            },
            {
              "scheme": "com.policyoffice.mobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.policyoffice.in/api/v1",
      "googleWebClientId": "",
      "googleIosClientId": "491076784026-raea045054it28h418q5samlkaqdv1lf.apps.googleusercontent.com",
      "googleAndroidClientId": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d71c39ba-a936-46e6-8c03-119d2ab1f0c2"
      }
    },
    "owner": "dipakgpatil"
  }
}
