{
  "name": "policyoffice-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "bundle:android": "node -e \"require('fs').mkdirSync('android/app/src/main/assets',{recursive:true})\" && npx expo export:embed --platform android --dev false --entry-file node_modules/expo-router/entry.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "apk:debug": "expo prebuild --platform android && npm run bundle:android && cd android && gradlew.bat assembleDebug",
    "apk:standalone": "expo prebuild --platform android && npm run bundle:android && cd android && gradlew.bat assembleDebug",
    "apk:dev": "expo prebuild --platform android && cd android && gradlew.bat assembleDebug",
    "apk:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-apk.ps1",
    "apk:release:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-apk.ps1 -SkipPrebuild -SkipClean",
    "play:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-apk.ps1 -RequireReleaseSigning",
    "play:release:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release-apk.ps1 -SkipPrebuild -SkipClean -RequireReleaseSigning",
    "assets:brand": "python scripts/generate_policyoffice_assets.py",
    "play:assets": "python scripts/generate_play_store_listing_assets.py",
    "eas:android:preview": "eas build --platform android --profile preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.39",
    "expo-auth-session": "~5.5.2",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "typescript": "~5.3.3"
  }
}
