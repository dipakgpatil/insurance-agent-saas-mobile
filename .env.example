# Override the API base URL. `/api/v1` is appended automatically if omitted.
# If unset, the app uses the value from app.json `extra.apiBaseUrl`.
EXPO_PUBLIC_API_URL=https://api.policyoffice.in/api/v1

# Legacy name also supported by src/lib/config.ts.
EXPO_PUBLIC_API_BASE_URL=https://api.policyoffice.in/api/v1

# Google OAuth client IDs for mobile signup/sign-in.
# Create these in the same Google/Firebase project as the backend verifier.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
