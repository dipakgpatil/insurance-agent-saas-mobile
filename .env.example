# Override the API base URL (must include the /api/v1 prefix).
# If unset, the app uses the value from app.json `extra.apiBaseUrl`.
EXPO_PUBLIC_API_BASE_URL=https://insurance-agent-saas-production.up.railway.app/api/v1

# Google OAuth client IDs for mobile signup/sign-in.
# Create these in the same Google/Firebase project as the backend verifier.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
